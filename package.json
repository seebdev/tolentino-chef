{
  "name": "tolentino-restaurantes-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "node scripts/start-production.mjs",
    "typecheck": "next typegen && tsc --noEmit",
