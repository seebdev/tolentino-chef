# Nuevo proyecto EXCLUSIVO para Tolentino. Nunca usar credenciales de la referencia.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Origen estable controlado por Tolentino; cambia localhost antes de imprimir QR.
APP_URL=http://localhost:3000
# Hostnames de plataforma separados por coma (no aceptar comodines).
PLATFORM_HOSTNAMES=localhost,127.0.0.1
# Opcional: verificar dominios y TLS con la API oficial de Render.
RENDER_API_KEY=
RENDER_SERVICE_ID=
RENDER_SERVICE_HOSTNAME=

# Traducción: secretos sólo servidor; cola persistente y presupuesto acumulado en Supabase.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini-2025-04-14
TRANSLATION_ENABLED=false
TRANSLATION_BUDGET_USD=0
TRANSLATION_MAX_OUTPUT_TOKENS=2048
